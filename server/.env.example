# Copy this file to .env and change every value before going live.

PORT=3000

# A long random secret used to sign login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# The first admin is created from these values the first time the server starts.
# After that you can remove ADMIN_PIN and ADMIN_PASSWORD from this file.
ADMIN_NAME=Sarrif Admin
ADMIN_PHONE=634000000
ADMIN_PIN=1357
ADMIN_PASSWORD=choose-a-strong-password

# Set to true when the site runs behind HTTPS (it should in production).
COOKIE_SECURE=false

# Database. Leave DATABASE_URL empty to use a SQLite file in DATA_DIR (fine for testing).
# For Supabase: Project → Connect → "Session pooler" → copy the URI and put your database password in it:
# DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Where the SQLite database and uploaded files are kept (not used when DATABASE_URL is set; files then go in the database).
DATA_DIR=./data
